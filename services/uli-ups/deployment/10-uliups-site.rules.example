// No verb=start: systemd uses it for StartTransientUnit as well.
// Example only: OWNER installs after reviewing real units, users and root-owned files.
// No unit-file management, transient units, properties, signals or arbitrary commands.
polkit.addRule(function(action, subject) {
    if (subject.user !== "uliups-site") {
        return;
    }
    if (action.id.indexOf("org.freedesktop.systemd1.") !== 0) {
        return;
    }
    if (action.id === "org.freedesktop.systemd1.manage-units") {
        var unit = action.lookup("unit");
        var verb = action.lookup("verb");
        if ((unit === "site-web.service" || unit === "uliups-site-build.service") &&
            (verb === "stop" || verb === "restart")) {
            return polkit.Result.YES;
        }
    }
    return polkit.Result.NO;
});
